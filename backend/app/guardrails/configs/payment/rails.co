define bot refuse blocked request
  "I can't help with that request."

define flow banking prompt integrity
  $rail_hit = execute check_prompt_integrity
  if $rail_hit
    create event InputRailException(message=$rail_hit)
    stop

define flow wire stripping
  $rail_hit = execute check_wire_stripping
  if $rail_hit
    create event InputRailException(message=$rail_hit)
    stop

define flow blocked funds
  $rail_hit = execute check_blocked_funds
  if $rail_hit
    create event InputRailException(message=$rail_hit)
    stop

define flow wire stripping output
  $rail_hit = execute check_wire_stripping
  if $rail_hit
    create event OutputRailException(message=$rail_hit)
    stop

define flow blocked funds output
  $rail_hit = execute check_blocked_funds
  if $rail_hit
    create event OutputRailException(message=$rail_hit)
    stop

define flow sensitive disclosure
  $rail_hit = execute sensitive_labels
  if $rail_hit
    $rail_masked = $rail_hit
    $redacted = execute redact_sensitive_output
    if $redacted
      bot $redacted
      stop
