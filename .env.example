# ---------------------------------------------------------------------------
# FinOps AI Command Center - environment template
# Copy to .env and fill in. Never commit a populated .env.
# ---------------------------------------------------------------------------

ENVIRONMENT=dev
LOG_LEVEL=INFO
LOG_JSON=true

# --- Database --------------------------------------------------------------
# SQLite is the zero-infrastructure default; use PostgreSQL beyond development.
DATABASE_URL=postgresql+asyncpg://finops:finops@localhost:5432/finops
POSTGRES_PASSWORD=finops

# --- Authentication --------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production-please-use-vault
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=1209600
BOOTSTRAP_ADMIN_EMAIL=admin@finops.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!2026

# --- AI providers (at least one is required to execute agents) -------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
TOGETHER_API_KEY=
OLLAMA_BASE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

DEFAULT_MODEL=claude-haiku-4-5
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3

# --- Infrastructure (all optional; each has an embedded fallback) ----------
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
ELASTICSEARCH_URL=
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=finops
MINIO_SECRET_KEY=finops-secret
MINIO_BUCKET=finops-artifacts
MINIO_SECURE=false
VAULT_ADDR=
VAULT_TOKEN=

# --- Identity / SSO --------------------------------------------------------
KEYCLOAK_URL=
KEYCLOAK_REALM=finops
KEYCLOAK_CLIENT_ID=finops-console
KEYCLOAK_CLIENT_SECRET=

# --- Observability ---------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=finops-api

# --- Background work -------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
TEMPORAL_HOST=
TEMPORAL_NAMESPACE=default

# --- External data APIs used by the research agent -------------------------
MARKET_DATA_API_KEY=
NEWS_API_KEY=
# SEC requires a contactable User-Agent on every EDGAR request
SEC_EDGAR_USER_AGENT=FinOps Command Center contact@yourbank.example

# --- Knowledge connectors --------------------------------------------------
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
CONFLUENCE_BASE_URL=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
SLACK_BOT_TOKEN=
GITHUB_TOKEN=
MSGRAPH_TENANT_ID=
MSGRAPH_CLIENT_ID=
MSGRAPH_CLIENT_SECRET=
SHAREPOINT_SITE_ID=

# --- Governance ------------------------------------------------------------
DAILY_COST_BUDGET_USD=500
MONTHLY_COST_BUDGET_USD=10000
PER_EXECUTION_COST_CAP_USD=5
RATE_LIMIT_PER_MINUTE=240
EXECUTION_TIMEOUT_SECONDS=900
APPROVAL_TIMEOUT_SECONDS=86400
MAX_CONCURRENT_EXECUTIONS=32
DATA_RETENTION_DAYS=400
# Both front-end applications call the same API, so both origins must be allowed.
# 5174/8080 = Execute, 5173/8090 = platform console.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8080,http://localhost:8090

# Which two agents the Execute console puts on its board by default. Any two of the five
# implemented agents; an operator can swap either slot in the UI.
EXECUTE_AGENTS=customer_service,aml_investigation

# --- NeMo Guardrails ---------------------------------------------------------
# Rail configurations live in backend/app/guardrails/configs/<agent_key>/. The Customer
# Service and AML agents ship with rails; an agent that declares them is refused rather
# than executed unguarded, so install the 'guardrails' extra or turn this off explicitly.
NEMO_GUARDRAILS_ENABLED=true
# The LLM-backed self-check rails. Also disabled automatically when no provider is
# configured; the deterministic pattern rails keep running either way.
NEMO_LLM_RAILS_ENABLED=true
# Model for the LLM-backed rails. Empty lets the router choose. Rails classify rather than
# write, so a small, cheap model is the right choice.
GUARDRAILS_MODEL=
# Block the run when an input rail refuses. Only turn this off while tuning a new rail.
NEMO_BLOCK_ON_INPUT_RAIL=true

# --- Frontend build --------------------------------------------------------
VITE_API_BASE_URL=
